NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: sin esto la búsqueda de libros usa la cuota anónima de Google Books,
# que es baja y compartida por IP (da 429 seguido). Con una clave propia (gratis)
# la cuota sube bastante. Se crea en https://console.cloud.google.com/apis/credentials
# habilitando la "Books API" y NUNCA lleva NEXT_PUBLIC_ porque solo se usa server-side.
GOOGLE_BOOKS_API_KEY=
